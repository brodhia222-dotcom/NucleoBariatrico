# Resend — solo necesario en producción / staging.
# Si no está seteado, /api/contact responde { ok: true, devMode: true }
# para que la demo no rompa.
RESEND_API_KEY=

# Email destino que recibe los leads. Sin esto cae al brand.email del copy.
CONTACT_TO_EMAIL=

# Email "from" verificado en Resend.
# En desarrollo se puede dejar onboarding@resend.dev.
CONTACT_FROM_EMAIL="Nucleo <onboarding@resend.dev>"
