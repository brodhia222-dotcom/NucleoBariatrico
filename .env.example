# Resend: única variable obligatoria en el sitio publicado.
# Sin ella, en los links de prueba los formularios funcionan en modo demo (no envían nada)
# y en producción avisan el error.
RESEND_API_KEY=

# Opcionales. Si no se cargan, salen de lib/copy.ts:
#   destino   = brand.email  (info@nucleobariatrico.com.ar)
#   remitente = "Nucleo Bariátrico <web@nucleobariatrico.com.ar>" (dominio verificado en Resend)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
